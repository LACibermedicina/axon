# axon — copie para .env (scripts/setup_vps.sh gera automaticamente; chmod 600)
PROJETO_NOME=axon
SUBDOMINIO=axon.m3d.pro
LE_EMAIL=
HTTP_PORT=
API_WORKERS=2
# Perfis opcionais: collab (WebRTC/salas) · data (PostgreSQL + Neo4j)
COMPOSE_PROFILES=
POSTGRES_DB=axon
POSTGRES_USER=axon
POSTGRES_PASSWORD=change-me
NEO4J_PASSWORD=change-me
JWT_SECRET=change-me
# --- IA (preenchidas pelo GitHub: secret SERVIDOR_ENV e/ou secrets individuais → merge-env.sh) ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GEMINI_API_KEY=
GITHUB_MODELS_TOKEN=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
TOGETHER_API_KEY=
AI_PROVIDERS=anthropic,openai,groq,gemini,github,cerebras,mistral,openrouter
AI_COOLDOWN_S=60
AI_TIMEOUT_S=45
# --- Portal (notícias, agenda, podcast, newsletter) ---
# ADMIN_TOKEN é gerado pelo setup_vps.sh; use-o para entrar em /admin.html
ADMIN_TOKEN=
# Envio do boletim por e-mail (opcional; sem isso, exporte o CSV ou use o RSS)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Voz dos episódios (usa OPENAI_API_KEY; sem chave, o site lê o roteiro com a voz do navegador)
PODCAST_VOICE=alloy
