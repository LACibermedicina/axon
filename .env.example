# Copie para .env (setup-vps.sh gera automaticamente com segredos aleatórios)
PROJETO_NOME=harmonia
SUBDOMINIO=harmonia.m3d.pro
LE_EMAIL=
POSTGRES_DB=harmonia
POSTGRES_USER=harmonia
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
JWT_SECRET=change-me-48-bytes-hex
DATA_ENCRYPTION_KEY=change-me-32-bytes-hex
TURN_SECRET=change-me
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-5
# Failover de IA: provedores tentados nesta ordem (só os que têm chave). Grave com infra/scripts/configurar-ia.sh
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
AI_PROVIDERS=anthropic,openai,gemini,openrouter
AI_COOLDOWN_S=60
AI_TIMEOUT_S=45
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Portas: escolhidas automaticamente pelo setup (altas, livres). Nunca < 1024.
HTTP_PORT=
TURN_PORT=
TURN_MIN_PORT=
TURN_MAX_PORT=
CLOUDFLARE_TUNNEL_TOKEN=
