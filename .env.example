# axon — copie para .env (scripts/setup_vps.sh gera automaticamente; chmod 600)
PROJETO_NOME=axon
SUBDOMINIO=axon.m3d.pro
LE_EMAIL=
HTTP_PORT=
API_WORKERS=2
# Perfis opcionais: collab (WebRTC/salas) · data (PostgreSQL + Neo4j)
COMPOSE_PROFILES=
POSTGRES_DB=axon
POSTGRES_USER=axon
POSTGRES_PASSWORD=change-me
NEO4J_PASSWORD=change-me
JWT_SECRET=change-me
# --- IA (preenchidas pelo GitHub: secret SERVIDOR_ENV e/ou secrets individuais → merge-env.sh) ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GEMINI_API_KEY=
GITHUB_MODELS_TOKEN=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
TOGETHER_API_KEY=
AI_PROVIDERS=anthropic,openai,groq,gemini,github,cerebras,mistral,openrouter
AI_COOLDOWN_S=60
AI_TIMEOUT_S=45
